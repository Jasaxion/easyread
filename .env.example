# One container, one HTTP port. Set an access code before network exposure.
EASYREAD_BIND_IP=127.0.0.1
EASYREAD_PORT=8765
EASYREAD_ALLOWED_HOSTS=
# Optional FIRST-RUN code (6–256 characters). Blank means disabled for personal use.
# Afterwards, enable/disable/change in Settings → Access protection.
# Set a unique cookie name when previewing beside another instance on this host.
# EASYREAD_ACCESS_COOKIE=easyread160_session
EASYREAD_ACCESS_CODE=

EASYREAD_BUILD_PROXY=
# Optional fast Python mirror in China: https://mirrors.aliyun.com/pypi/simple
EASYREAD_PIP_INDEX_URL=https://pypi.org/simple
# Download domestic mirrors directly; keep overseas CLI downloads on the proxy.
EASYREAD_BUILD_NO_PROXY=localhost,127.0.0.1,.aliyun.com,.tsinghua.edu.cn
EASYREAD_HTTP_PROXY=
EASYREAD_HTTPS_PROXY=
CLAUDE_CODE_VERSION=2.1.309
CODEX_VERSION=0.169.0

# Research workspace full-image native tools (official release binaries).
BEADS_VERSION=1.3.4
DOLT_VERSION=2.7.5
# Required when selecting another Dolt release; use its platform asset SHA-256.
DOLT_SHA256=
# Optional apt package set, including package=version pins if your mirror retains them.
EASYREAD_TEXLIVE_PACKAGES=texlive-latex-base texlive-latex-recommended texlive-latex-extra texlive-fonts-recommended texlive-xetex texlive-luatex texlive-lang-chinese texlive-bibtex-extra latexmk biber
# Total wall-clock budget per compile (clamped to 5..600 seconds).
EASYREAD_TEX_TIMEOUT=120
# Source/desktop only: absolute engine overrides, never project-controlled values.
# EASYREAD_TEX_PDFLATEX=/path/to/pdflatex
# EASYREAD_TEX_XELATEX=/path/to/xelatex
# EASYREAD_TEX_LUALATEX=/path/to/lualatex
