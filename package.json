{
  "name": "easyread-desktop",
  "version": "1.5.2",
  "description": "EasyRead desktop application powered by Electron",
  "author": "Edwardxlai",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:editor": "node scripts/build_note_editor.cjs && npm run build:workspace-editor",
    "build:whiteboard": "node scripts/build_whiteboard.cjs",
    "build:workspace-editor": "node scripts/build_workspace_editor.cjs",
    "build:backend": "python scripts/build_backend.py",
    "dist": "npm run build:editor && npm run build:whiteboard && npm run build:backend && electron-builder --publish never"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "markdown-it": "^14.3.3",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.106.1"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "Edwardxlai",
        "repo": "easyread"
      }
    ],
    "appId": "com.edwardxlai.easyread",
    "productName": "EasyRead",
    "protocols": [
      {
        "name": "EasyRead",
        "schemes": [
          "easyread"
        ]
      }
    ],
    "asar": true,
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "icon": "electron/assets",
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer/installer.nsh",
      "createDesktopShortcut": true,
      "artifactName": "EasyRead-Setup-${version}.exe"
    },
    "mac": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "publications",
      "identity": null,
      "hardenedRuntime": false
    },
    "afterSign": "scripts/mac_sign.cjs",
    "linux": {
      "icon": "electron/assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
